<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>fingraph-eval: {{ agent_type }} Report</title>
<style>
  body{font-family:-apple-system,sans-serif;max-width:960px;margin:40px auto;padding:0 20px}
  h1{color:#1a1a2e}
  .summary{display:flex;gap:24px;margin:24px 0}
  .stat{background:#f5f5f5;border-radius:8px;padding:16px 24px}
  .stat .val{font-size:2rem;font-weight:bold}
  .stat .lbl{color:#666;font-size:.85rem}
  table{width:100%;border-collapse:collapse;margin-top:24px}
  th{background:#1a1a2e;color:#fff;padding:10px 14px;text-align:left}
  td{padding:10px 14px;border-bottom:1px solid #eee;vertical-align:top}
  .pass{color:#22c55e}.fail{color:#ef4444}
  .badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:.8rem;font-weight:bold}
  .badge-pass{background:#dcfce7;color:#166534}
  .badge-fail{background:#fee2e2;color:#991b1b}
</style>
</head>
<body>
<h1>fingraph-eval: {{ agent_type|upper }} Report</h1>
<div class="summary">
  <div class="stat"><div class="val">{{ aggregate.total }}</div><div class="lbl">Total Cases</div></div>
  <div class="stat"><div class="val pass">{{ aggregate.passed }}</div><div class="lbl">Passed</div></div>
  <div class="stat"><div class="val fail">{{ aggregate.failed }}</div><div class="lbl">Failed</div></div>
  <div class="stat"><div class="val">{{ pass_pct }}</div><div class="lbl">Pass Rate</div></div>
  <div class="stat"><div class="val">{{ "%.1f"|format(aggregate.avg_elapsed_seconds) }}s</div><div class="lbl">Avg Latency</div></div>
</div>
<table>
  <thead><tr><th>ID</th><th>Query</th><th>Finding</th><th>Scores</th><th>Result</th><th>Time</th></tr></thead>
  <tbody>
  {% for r in case_results %}
  <tr>
    <td><code>{{ r.case_id }}</code></td>
    <td>{{ r.query }}</td>
    <td style="max-width:300px;font-size:.85rem">{{ r.finding[:150] }}{% if r.finding|length > 150 %}…{% endif %}</td>
    <td>{% for s in r.scores %}<div>{{ s.scorer }}: <strong>{{ "%.2f"|format(s.value) }}</strong></div>{% endfor %}</td>
    <td>{% if r.passed %}<span class="badge badge-pass">PASS</span>{% else %}<span class="badge badge-fail">FAIL</span>{% endif %}</td>
    <td>{{ "%.1f"|format(r.elapsed_seconds) }}s</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</body>
</html>
